[Unit]
Description=tidepool board (WebUI + /api + /mcp + scheduler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=masaki
Group=masaki
WorkingDirectory=/opt/tidepool
EnvironmentFile=/etc/default/tidepool
# ADR 0099 決定5: worker 容器(per-session cgroup v2)は盤面自身の cgroup 配下に作る
Delegate=yes
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
