{
  "enabledPlugins": {
    "ponytail@ponytail": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(gh *)", "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/inject-triage-labels.mjs" }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/inject-triage-labels.mjs" }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/rescue-scratch-e2e.sh" }
        ]
      }
    ]
  }
}
