{
  "name": "tidepool",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "pretest": "node scripts/test-preflight.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:scratch": "PLAYWRIGHT_SCRATCH=1 playwright test",
    "start": "tsx src/main.ts",
    "token": "tsx scripts/token.ts",
    "start:live": "TIDEPOOL_REGISTRY=$HOME/tidepool-registry tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build:webui": "node scripts/build-webui-bundle.mjs",
    "build:ds-bundle": "node scripts/build-ds-bundle.mjs",
    "preview:settings": "tsx scripts/preview-settings.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@twemoji/parser": "^17.0.2",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.1",
    "lucide": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
