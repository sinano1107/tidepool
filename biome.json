{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!public/app.js", "!public/vendor/**", "!docs/experiments/**/targets/**"]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"preset": "recommended"
			}
		}
	},
	"overrides": [
		{
			"includes": ["webui/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "error"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
