{
	"$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!public/app.js", "!public/vendor/**", "!docs/experiments/**/targets/**"]
	},
	"formatter": {
		"enabled": false
	},
	"plugins": ["./no-board-db-in-expect.grit", "./no-board-select.grit", "./no-board-db-alias.grit"],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"preset": "recommended"
			},
			"suspicious": {
				"noImportCycles": {
					"level": "error",
					"options": {
						"ignoreTypes": true
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/**", "public/**", "webui/**"],
			"plugins": ["./no-adr-in-board-text.grit"]
		},
		{
			"includes": ["src/**"],
			"plugins": ["./no-raw-res-json.grit"]
		},
		{
			"includes": ["**", "!tests/**", "!src/registry-unreadable.ts"],
			"plugins": ["./no-direct-registry-load.grit", "./no-direct-registry-load-alias.grit", "./no-direct-registry-load-member.grit"]
		},
		{
			"includes": ["src/**", "!src/git.ts"],
			"plugins": ["./no-git-child-outside-git-module.grit"]
		},
		{
			"includes": ["src/**", "!src/git.ts", "!src/github-auth.ts"],
			"plugins": ["./no-network-git-outside-github-auth.grit"]
		},
		{
			"includes": ["src/mcp.ts", "src/management-mcp.ts"],
			"plugins": ["./no-raw-tool-content.grit"]
		},
		{
			"includes": ["webui/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "error"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
